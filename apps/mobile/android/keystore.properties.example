# Copy this file to apps/mobile/android/keystore.properties for a signed release.
# Never commit keystore.properties, the referenced keystore, or its passwords.
#
# storeFile is resolved relative to apps/mobile/android/app/ unless absolute.
# A common local layout is apps/mobile/android/app/release.jks, ignored by *.jks.
# For CI, write the keystore from a base64 secret before invoking Gradle and
# build with -PrequireReleaseSigning=true so a missing secret fails closed.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=novatask
keyPassword=CHANGE_ME

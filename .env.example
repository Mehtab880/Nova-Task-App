# Nova Task build environment reference.
# This repository does not auto-load .env files. Export these variables in the
# shell that runs Metro or Gradle. NEVER commit real secrets.
#
# NOVA_APP_ENV: dev | staging | prod. Inlined at bundle time by Babel when set.
# If omitted, the native Gradle flavor APP_ENV constant is used; Jest/debug
# fallback remains "dev" when no native module is available.
NOVA_APP_ENV=dev

# Public API origin. M0 ships no network calls; this is a placeholder for M1.
NOVA_API_BASE_URL=http://10.0.2.2:8080

# Enables the M0 SQLite spike entry point in the Nova tab (dev builds only).
NOVA_ENABLE_M0_SPIKE=true
